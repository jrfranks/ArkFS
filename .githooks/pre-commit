#!/bin/sh
# Full local bar: all package tests, clippy, Kani, Miri, llvm-cov, live FUSE.
# GitHub Actions does not run this (it uses make ci). Enable with:
#   make install-hooks
# Bypass: git commit --no-verify  or  ARKFS_SKIP_PRECOMMIT=1 (emergency only).
# This hook must stay a POSIX sh script; do not assume bash.

if [ "${ARKFS_SKIP_PRECOMMIT}" = 1 ]; then
	echo "ARKFS_SKIP_PRECOMMIT=1: skipping full pre-commit suite" >&2
	exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
exec make precommit
