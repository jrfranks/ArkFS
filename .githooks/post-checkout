#!/bin/sh
# Runs after `git clone` (once hooksPath is set) and every `git checkout`.
# Installs rustfmt/clippy/Kani/Miri/llvm-cov if they are missing.
# GitHub sets CI and must not run this installer.

if [ -n "${CI:-}" ] || [ "${ARKFS_SKIP_SETUP:-}" = 1 ]; then
	exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
exec sh "$root/scripts/setup-tools.sh"
